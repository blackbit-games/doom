{
  "name": "Freedoom",
  "short_name": "Freedoom",
  "description": "Freedoom und Doom Shareware im Browser, mit Controller oder Touch.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "fullscreen",
  "orientation": "landscape",
  "background_color": "#120c0b",
